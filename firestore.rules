rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin'
      );
    }

    function isTeacherOrAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'teacher' || 
        getUserData().role == 'admin' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'teacher'
      );
    }

    // ==========================================================
    // CONFIG / ADMIN LOCK
    // Single admin race-safe lock:
    // Can only be created once with adminUid == request.auth.uid.
    // Client cannot update or delete it.
    // ==========================================================
    match /config/adminLock {
      allow read: if true; // Public check so register page can disable admin option
      allow create: if isAuthenticated() &&
                    !exists(/databases/$(database)/documents/config/adminLock) &&
                    request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if false; // Immutable lock
    }

    // ==========================================================
    // USERS COLLECTION
    // Users cannot change their own role, admin status, or linked students.
    // Role 'admin' is ONLY allowed if config/adminLock does not exist yet
    // and is created in the same write batch with adminUid == caller.
    // ==========================================================
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated() && (
        // Non-admin roles (student, teacher, parent)
        (
          request.resource.data.role in ['student', 'teacher', 'parent'] &&
          request.auth.uid == userId
        ) ||
        // Admin role: allowed ONLY if config/adminLock doesn't exist yet and lock is written
        (
          request.resource.data.role == 'admin' &&
          request.auth.uid == userId &&
          !exists(/databases/$(database)/documents/config/adminLock)
        )
      );

      // Users can update their display profile, but CANNOT change role or adminUid
      allow update: if isOwner(userId) &&
                    request.resource.data.role == resource.data.role;

      allow delete: if false;
    }

    // Students Collection
    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isTeacherOrAdmin();
    }

    // Interventions Collection
    match /interventions/{interventionId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isTeacherOrAdmin();
    }
  }
}
